# Postgres connection string (optional - the demo runs in-memory when absent/unreachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reconciler
# Google AI Studio API key (optional - a local heuristic fallback is used when absent)
GEMINI_API_KEY=
# Generation model. Leave empty to default to gemini-3.6-flash (gemini-2.0-flash is retired).
GEMINI_MODEL=
# Optional same-tier LLM fallback (not used by the demo)
GROQ_API_KEY=
# Uvicorn port
PORT=8000
